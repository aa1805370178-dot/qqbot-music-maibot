{
  "manifest_version": 2,
  "version": "1.0.0",
  "name": "QQ 机器人唱歌（qqbot-music）",
  "description": "给麦麦一个 sing 工具：用你配置的音色唱歌、发语音。需要另外运行 qqbot-music 唱歌服务（https://github.com/aa1805370178-dot/qqbot-music）。",
  "author": {
    "name": "小小墨",
    "url": "https://github.com/aa1805370178-dot"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/aa1805370178-dot/qqbot-music-maibot",
    "homepage": "https://github.com/aa1805370178-dot/qqbot-music",
    "documentation": "https://github.com/aa1805370178-dot/qqbot-music-maibot#readme",
    "issues": "https://github.com/aa1805370178-dot/qqbot-music-maibot/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.custom",
    "config.get"
  ],
  "id": "qqbot-music.sing",
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}